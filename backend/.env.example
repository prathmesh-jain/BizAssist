# LLM
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-4.1-mini
FAST_MODEL=gpt-4.1-mini
NANO_MODEL=gpt-4.1-mini
USER_SECRETS_ENCRYPTION_KEY=
# Local development only: lets a custom provider base URL point at localhost (e.g. Ollama)
ALLOW_PRIVATE_LLM_BASE_URLS=false

# Retrieval / chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=120
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_SIZE=1536
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PORT=6333
QDRANT_DOCUMENTS_COLLECTION=business_docs
QDRANT_TOOL_CATALOG_COLLECTION=tool_catalog

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bizassist

# Firebase Auth (backend)
FIREBASE_PROJECT_ID=
FIREBASE_TYPE=service_account
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=

# Google OAuth / Sheets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS='["http://localhost:5173"]'

# Public web app URL (used in invitation links)
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_DAYS=7

# Business research. "browser" (default) searches the engines below with headless Chromium
# (Playwright; run `playwright install chromium` once). Alternatives: "openai" (web search on the
# user's own OpenAI key) or "google_api" (needs the two Google values below).
RESEARCH_SEARCH_PROVIDER=browser
RESEARCH_SEARCH_ENGINES=yahoo,bing,google
RESEARCH_CRAWLER=browser
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
RESEARCH_MAX_WEBSITE_PAGES=5

# Guardrails
USE_GUARDRAIL=true

# Agent runtime
AGENT_RUN_RETRIES=2
PLANNER_MAX_ITERATIONS=4

# Chat attachment cleanup
CHAT_TMP_TTL_SECONDS=86400
CHAT_TMP_SWEEP_INTERVAL_SECONDS=900

# Optional LangSmith
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
